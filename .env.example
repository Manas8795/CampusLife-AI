# =============================================================================
# CampusLife AI — Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env  →  cp .env.example .env
#   2. Fill in your actual credential values below.
#   3. NEVER commit .env to version control (it is already in .gitignore).
#
# Security: All secrets MUST be set via environment / .env.
#           Hardcoded defaults have been removed from config.py per OWASP A02.
# =============================================================================

# --- Core Application ---
PROJECT_NAME="CampusLife AI"
DATABASE_URL="sqlite:///./campuslife.db"

# IMPORTANT: Change this to a long, random secret key in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-a-secure-random-secret-key"

# --- AI / LLM Configuration ---
# Ollama runs locally — no key needed. Set model name if using a different model.
LOCAL_LLM_URL="http://127.0.0.1:11434"
LOCAL_LLM_MODEL="llama3.2:1b"

# Optional: Cloud LLM fallback (leave blank to use only local Ollama)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Persona: EMPATHETIC_MENTOR | PRODUCTIVITY_COACH | CAMPUS_PEER
STUDENT_PERSONA="EMPATHETIC_MENTOR"

# --- Twilio Telephony (Optional — simulated provider used if omitted) ---
# Obtain from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- Telegram Voice Bot (Optional — used for TTS audio delivery) ---
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_BASE="https://api.telegram.org"
TELEGRAM_PROXY=""
